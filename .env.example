# Local infrastructure
POSTGRES_DB=motolink
POSTGRES_USER=motolink
POSTGRES_PASSWORD=motolink_dev
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend
SERVER_PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

# RTC is intentionally disabled in the scaffold.
# Configure one provider after the real-device POC.
RTC_PROVIDER=mock
RTC_APP_ID=
RTC_APP_SECRET=

# Map provider is also injected at deployment time.
MAP_PROVIDER=mock
AMAP_ANDROID_KEY=
AMAP_IOS_KEY=
